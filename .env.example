# Local example values for docker compose (hostnames are compose services).
# Copy to .env to override; no real secrets here.
HTTP_ADDR=:8080
# The app connects as the least-privilege role created by the migrations
# (INSERT and SELECT only on ledger_entries, no DELETE anywhere).
DATABASE_URL=postgres://wallet_app:wallet_app@postgres:5432/wallet?sslmode=disable
# Schema owner, used only by the migrate service.
MIGRATE_DATABASE_URL=postgres://wallet:wallet@postgres:5432/wallet?sslmode=disable
AWS_ENDPOINT_URL=http://ministack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=wallet-consumer
AWS_SECRET_ACCESS_KEY=local-secret
SQS_INPUT_QUEUE_URL=http://ministack:4566/000000000000/wager-transactions.fifo
SQS_EVENTS_QUEUE_URL=http://ministack:4566/000000000000/wallet-events.fifo
# Dead-letter queue of the input queue; required with the consumer role.
SQS_DLQ_QUEUE_URL=http://ministack:4566/000000000000/wager-transactions-dlq.fifo
APP_ROLES=api,consumer,outbox,pending
SHUTDOWN_TIMEOUT=25s
# Outbox publisher (role outbox).
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_DURATION=30s
OUTBOX_RETRY_BASE=1s
OUTBOX_RETRY_MAX=5m
# Pending References: retry schedule (every role) and worker (role pending).
PENDING_MAX_ATTEMPTS=8
PENDING_RETRY_BASE=2s
PENDING_RETRY_MAX=2m
PENDING_POLL_INTERVAL=1s
PENDING_BATCH_SIZE=20
PENDING_LEASE_DURATION=30s

# Input queue consumer (role consumer).
CONSUMER_NAME=wager-transactions
CONSUMER_CONCURRENCY=10
CONSUMER_WAIT_TIME=20s
CONSUMER_VISIBILITY_TIMEOUT=30s
CONSUMER_RETRY_BASE=1s
CONSUMER_RETRY_MAX=2m
LOG_LEVEL=info
# Must equal the "iss" of the tokens (Keycloak pins it with KC_HOSTNAME).
# In compose the app service overrides it from KEYCLOAK_PORT.
OIDC_ISSUER_URL=http://localhost:8081/realms/wallet
OIDC_AUDIENCE=wallet-api
# The issuer host (localhost:8081) is not reachable from inside the compose
# network, so the app fetches the signing keys through the service name.
OIDC_JWKS_URL=http://keycloak:8080/realms/wallet/protocol/openid-connect/certs

# Compose-only (not read by the app): host port of Keycloak. It also sets the
# token issuer (KC_HOSTNAME) and the app's OIDC_ISSUER_URL. Compose reads it
# from the shell or from .env, so uncomment it in .env when 8081 is taken.
# KEYCLOAK_PORT=8081

# Fault-injection builds only (-tags faultinject): exit with code 137 at the
# named crashpoint, e.g. outbox.after_publish. Leave unset otherwise.
# CRASH_AT=
