# Local example values for docker compose (hostnames are compose services).
# Copy to .env to override; no real secrets here.
HTTP_ADDR=:8080
# The app connects as the least-privilege role created by the migrations
# (INSERT and SELECT only on ledger_entries, no DELETE anywhere).
DATABASE_URL=postgres://wallet_app:wallet_app@postgres:5432/wallet?sslmode=disable
# Schema owner, used only by the migrate service.
MIGRATE_DATABASE_URL=postgres://wallet:wallet@postgres:5432/wallet?sslmode=disable
AWS_ENDPOINT_URL=http://ministack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=wallet-consumer
AWS_SECRET_ACCESS_KEY=local-secret
SQS_INPUT_QUEUE_URL=http://ministack:4566/000000000000/wager-transactions.fifo
SQS_EVENTS_QUEUE_URL=http://ministack:4566/000000000000/wallet-events.fifo
APP_ROLES=api,consumer,outbox,pending
SHUTDOWN_TIMEOUT=25s
LOG_LEVEL=info
# Must equal the "iss" of the tokens (Keycloak pins it with KC_HOSTNAME).
OIDC_ISSUER_URL=http://localhost:8081/realms/wallet
OIDC_AUDIENCE=wallet-api
# The issuer host (localhost:8081) is not reachable from inside the compose
# network, so the app fetches the signing keys through the service name.
OIDC_JWKS_URL=http://keycloak:8080/realms/wallet/protocol/openid-connect/certs
